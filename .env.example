# URL pública. No primeiro deploy, use o domínio *.up.railway.app gerado pelo Railway.
NEXT_PUBLIC_SITE_URL=https://SEU-SITE.up.railway.app

# OBRIGATÓRIO EM PRODUÇÃO: segredo forte para os cookies de sessão.
AUTH_SECRET=gere-um-segredo-longo-e-aleatorio

# Primeiro moderador. Só é criado se ainda não existir nenhum moderador no volume.
INITIAL_ADMIN_NAME=Nome do Moderador
INITIAL_ADMIN_USERNAME=moderador
INITIAL_ADMIN_EMAIL=seu-email@exemplo.com
INITIAL_ADMIN_PASSWORD=use-uma-senha-forte-com-10-ou-mais-caracteres

# Segundo moderador opcional.
# INITIAL_ADMIN2_NAME=Segundo Moderador
# INITIAL_ADMIN2_USERNAME=moderador2
# INITIAL_ADMIN2_EMAIL=segundo@exemplo.com
# INITIAL_ADMIN2_PASSWORD=outra-senha-forte

# SMTP para recuperação de senha. Configure antes de oferecer recuperação por e-mail.
SMTP_HOST=smtp.exemplo.com
SMTP_PORT=587
SMTP_USER=usuario@exemplo.com
SMTP_PASS=senha-ou-app-password
EMAIL_FROM="Comunidade Santa Luzia <nao-responda@exemplo.com>"

# Fontes públicas da liturgia diária.
LITURGIA_SOURCE_URL=https://liturgia.cancaonova.com/pb/
SANTO_SOURCE_URL=https://santo.cancaonova.com/

# Railway: a aplicação grava em ./data. Monte o Volume em /app/data.
# DATA_DIR pode ficar ausente quando o Volume estiver montado em /app/data.
